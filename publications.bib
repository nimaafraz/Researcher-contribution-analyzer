@CONFERENCE{Taylor2009522,
	author = {Taylor, Graham W. and Hinton, Geoffrey E.},
	title = {Products of Hidden Markov Models: It takes N>1 to Tango},
	year = {2009},
	journal = {Proceedings of the 25th Conference on Uncertainty in Artificial Intelligence, UAI 2009},
	pages = {522 – 529},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-80053143476&partnerID=40&md5=b1c791442e7392c3bb07084a3a440a73},
	affiliations = {Dept. of Computer Science, University of Toronto, Toronto, M5S 2Z9, Canada},
	abstract = {Products of Hidden Markov Models (PoHMMs) are an interesting class of generative models which have received little attention since their introduction. This may be in part due to their more computationally expensive gradient-based learning algorithm, and the intractability of computing the log likelihood of sequences under the model. In this paper, we demonstrate how the partition function can be estimated reliably via Annealed Importance Sampling. We perform experiments using contrastive divergence learning on rainfall data and data captured from pairs of people dancing. Our results suggest that advances in learning and evaluation for undirected graphical models and recent increases in available computing power make PoHMMs worth considering for complex time-series modeling tasks.},
	keywords = {Artificial intelligence; Importance sampling; Learning algorithms; Learning systems; Complex time series; Computing power; Contrastive divergence; Generative model; Gradient-based learning; GraphicaL model; Log likelihood; Partition functions; Hidden Markov models},
	correspondence_address = {G.W. Taylor; Dept. of Computer Science, University of Toronto, Toronto, M5S 2Z9, Canada; email: gwtaylor@cs.toronto.edu},
	publisher = {AUAI Press},
	language = {English},
	abbrev_source_title = {Proc. Conf. Uncertainty Artif. Intell., UAI},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

