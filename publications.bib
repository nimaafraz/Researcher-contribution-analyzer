	keywords = {Learning algorithms; Maps; Numerical analysis; Three dimensional; Visualization; Data sets; Different scales; Dimensional datums; Dimensionality reduction; Embedding algorithms; Locally linear embedding.; Manifold learning; Multidimensional scaling; Multiple classes; Multiple viewpoints; Neighborhood graphs; New techniques; Random walks; Sammon mappings; Stochastic neighbor embedding; Very large datums; Visualization techniques; Data visualization},
