@CONFERENCE{Chen2022,
	author = {Chen, Ting and Saxena, Saurabh and Li, Lala and Fleet, David J. and Hinton, Geoffrey},
	title = {PIX2SEQ: A LANGUAGE MODELING FRAMEWORK FOR OBJECT DETECTION},
	year = {2022},
