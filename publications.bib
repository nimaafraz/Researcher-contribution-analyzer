@CONFERENCE{Chen20201575,
	author = {Chen, Ting and Kornblith, Simon and Norouzi, Mohammad and Hinton, Geoffrey},
	title = {A simple framework for contrastive learning of visual representations},
	year = {2020},
	journal = {37th International Conference on Machine Learning, ICML 2020},
	volume = {PartF168147-3},
	pages = {1575 – 1585},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85105185174&partnerID=40&md5=29b4d3929d35325ea4a9a495e5effd39},
	affiliations = {Google Research, Brain Team, United States},
	abstract = {This paper presents SimCLR: a simple framework for contrastive learning of visual representations. We simplify recently proposed contrastive self-supervised learning algorithms without requiring specialized architectures or a memory bank. In order to understand what enables the contrastive prediction tasks to learn useful representations, we systematically study the major components of our framework. We show that (1) composition of data augmentations plays a critical role in defining effective predictive tasks, (2) introducing a learnable nonlinear transformation between the representation and the contrastive loss substantially improves the quality of the learned representations, and (3) contrastive learning benefits from larger batch sizes and more training steps compared to supervised learning. By combining these findings, we are able to considerably outperform previous methods for self-supervised and semi-supervised learning on ImageNet. A linear classifier trained on self-supervised representations learned by SimCLR achieves 76.5% top-1 accuracy, which is a 7% relative improvement over previous state-of-the-art, matching the performance of a supervised ResNet-50. When fine-tuned on only 1% of the labels, we achieve 85.8% top-5 accuracy, outperforming AlexNet with 100× fewer labels. © 37th International Conference on Machine Learning, ICML 2020.},
	keywords = {Learning systems; Mathematical transformations; Metadata; Semi-supervised learning; Batch sizes; Data augmentation; Linear classifiers; Memory banks; Non-linear transformations; Prediction tasks; State of the art; Visual representations; Learning algorithms},
	correspondence_address = {T. Chen; Google Research, Brain Team, United States; email: iamtingchen@google.com},
