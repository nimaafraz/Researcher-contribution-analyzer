	isbn = {0262122413; 978-026212241-2},
	language = {English},
	abbrev_source_title = {Adv. neural inf. proces. syst.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 90; Conference name: 14th Annual Neural Information Processing Systems Conference, NIPS 2000; Conference date: 27 November 2000 through 2 December 2000; Conference code: 104685}
}

@CONFERENCE{Deng20101692,
	author = {Deng, L. and Seltzer, M. and Yu, D. and Acero, A. and Mohamed, A. and Hinton, G.},
	title = {Binary coding of speech spectrograms using a deep auto-encoder},
	year = {2010},
	journal = {Proceedings of the 11th Annual Conference of the International Speech Communication Association, INTERSPEECH 2010},
	pages = {1692 – 1695},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-79959842828&partnerID=40&md5=64907570612830d8c11dec1431368dc4},
	affiliations = {Microsoft Research, Redmond, WA 98052, One Microsoft Way, United States; University of Toronto, Toronto, ON, Canada},
	abstract = {This paper reports our recent exploration of the layer-by-layer learning strategy for training a multi-layer generative model of patches of speech spectrograms. The top layer of the generative model learns binary codes that can be used for efficient compression of speech and could also be used for scalable speech recognition or rapid speech content retrieval. Each layer of the generative model is fully connected to the layer below and the weights on these connections are pre-trained efficiently by using the contrastive divergence approximation to the log likelihood gradient. After layer-by-layer pre-training we "unroll" the generative model to form a deep auto-encoder, whose parameters are then fine-tuned using back-propagation. To reconstruct the full-length speech spectrogram, individual spectrogram segments predicted by their respective binary codes are combined using an overlap-and-add method. Experimental results on speech spectrogram coding demonstrate that the binary codes produce a log-spectral distortion that is approximately 2 dB lower than a sub-band vector quantization technique over the entire frequency range of wide-band speech. © 2010 ISCA.},
	author_keywords = {Auto-encoder; Binary codes; Boltzmann machine; Deep learning; Neural networks; Speech feature extraction},
	keywords = {Backpropagation; Binary codes; Deep learning; Deep neural networks; Learning systems; Neural networks; Signal encoding; Spectrographs; Speech; Speech communication; Vector quantization; Network coding; Auto encoders; Boltzmann machines; Contrastive divergence; Generative model; Learning strategy; Log spectral distortions; Speech features; Speech spectrogram; Deep learning; Features extraction; Layer by layer; Neural-networks; Speech feature extraction; Speech recognition},
	correspondence_address = {L. Deng; Microsoft Research, Redmond, WA 98052, One Microsoft Way, United States; email: deng@microsoft.com},
	publisher = {International Speech Communication Association},
	language = {English},
	abbrev_source_title = {Proc. Annu. Conf. Int. Speech Commun. Assoc., INTERSPEECH},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 270}
}

